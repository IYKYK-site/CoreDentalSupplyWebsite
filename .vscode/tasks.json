{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Claudia",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8101 --reload",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Restart Claudia",
      "type": "shell",
      "command": "pkill -f 'uvicorn app.main:app' || true; ${workspaceFolder}/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8101 --reload",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    },
    {
      "label": "Stop Claudia",
      "type": "shell",
      "command": "pkill -f 'uvicorn app.main:app' || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Start ngrok",
      "type": "shell",
      "command": "/opt/homebrew/bin/ngrok http 8101",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m pytest tests",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check Python Syntax",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -c \"import ast, pathlib; root = pathlib.Path('.'); files = [p for p in root.rglob('*.py') if not any(part.startswith('.') for part in p.parts)]; [ast.parse(p.read_text(encoding='utf-8'), filename=str(p)) for p in files]; print(f'Checked {len(files)} Python files')\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
