OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
PUBLIC_URL=https://YOUR-NGROK-OR-PUBLIC-HOST
OFFICE_CONFIG=office.yaml

# Google OAuth files generated by scripts/google_auth.py
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json

# Required for inbound calling and the realtime bridge.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# SMS is enabled in office.yaml. Configure one sender option.
# Prefer a Messaging Service SID when available; otherwise use the Twilio number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=
